---
interface Props {
	title: string;
	description: string;
	stack: string[];
	status?: string;
	repoUrl?: string;
	liveUrl?: string;
}

const { title, description, stack, status, repoUrl, liveUrl } = Astro.props;
---

<article class="flex flex-col gap-4 rounded-xl border border-line bg-white/60 p-6">
	<div class="flex items-start justify-between gap-3">
		<h3 class="font-display text-xl text-ink">{title}</h3>
		{status && <span class="whitespace-nowrap rounded-full bg-amber/20 px-2.5 py-1 text-xs text-ink-soft">{status}</span>}
	</div>

	<p class="text-sm leading-relaxed text-ink-soft">{description}</p>

	<ul class="flex flex-wrap gap-2 font-mono text-xs text-indigo-dim">
		{stack.map((tech) => <li class="rounded-md bg-indigo/10 px-2 py-1">{tech}</li>)}
	</ul>

	{
		(repoUrl || liveUrl) && (
			<div class="mt-1 flex gap-4 text-sm">
				{repoUrl && (
					<a href={repoUrl} class="text-indigo underline decoration-line underline-offset-4 hover:decoration-indigo" target="_blank" rel="noreferrer">
						Código
					</a>
				)}
				{liveUrl && (
					<a href={liveUrl} class="text-indigo underline decoration-line underline-offset-4 hover:decoration-indigo" target="_blank" rel="noreferrer">
						Demo
					</a>
				)}
			</div>
		)
	}
</article>
